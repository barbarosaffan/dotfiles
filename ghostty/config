# Ghostty Configuration

# Font Settings
font-family = GeistMono Nerd Font Mono
font-size = 16
font-thicken = true
font-feature = ss09

# Window Settings
window-width = 120
window-height = 20
window-padding-x = 8
window-padding-y = 8
macos-titlebar-style = tabs
window-save-state = always
confirm-close-surface = false
resize-overlay = never

# Shell Integration
auto-update = check

# Cursor Style
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

# Mouse
mouse-hide-while-typing = true

# Clipboard
copy-on-select = clipboard
clipboard-paste-protection = false

# Scrollback
scrollback-limit = 10000

# Visual
background-opacity = 1.0
unfocused-split-opacity = 0.85
bold-is-bright = false

# Theme
background = #000000
foreground = #ffffff
selection-background = #333333
selection-foreground = #ffffff

# Palette — keep colors readable on pure black
palette = 0=#1c1c1c
palette = 1=#ff5f5f
palette = 2=#5fdf5f
palette = 3=#dfdf5f
palette = 4=#5f87ff
palette = 5=#df5fff
palette = 6=#5fdfdf
palette = 7=#c8c8c8
palette = 8=#3a3a3a
palette = 9=#ff8787
palette = 10=#87ff87
palette = 11=#ffff87
palette = 12=#87afff
palette = 13=#ff87ff
palette = 14=#87ffff
palette = 15=#ffffff

# Keybindings
keybind = cmd+k=clear_screen
keybind = cmd+shift+f=toggle_fullscreen

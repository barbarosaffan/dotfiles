// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_icon": true,
  },
  "ui_font_family": "Geist",
  "icon_theme": "Zed (Default)",
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "agent": {
    "play_sound_when_agent_done": true,
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        // Set your Context7 API key here or via environment variable
        "context7_api_key": "",
      },
    },
  },
  "terminal": {
    "env": {
      "Q_NEW_SESSION": "\"1\"",
    },
    "font_size": 14.0,
    "font_family": "GeistMono Nerd Font Mono",
  },
  "base_keymap": "VSCode",
  "tab_bar": {
    "show": true,
  },
  "cursor_shape": "block",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_family": "MonoLisa",
  "linked_edits": true,
  "show_whitespaces": "all",
  "show_edit_predictions": true,
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
}

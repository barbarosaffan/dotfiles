{
  "editor.suggestSelection": "first",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always",
    "source.organizeImports": "always",
    "source.fixAll.ts": "always"
  },
  "terminal.integrated.tabs.enabled": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.detectIndentation": true,
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "editor.linkedEditing": true,
  "terminal.integrated.fontFamily": "GeistMono Nerd Font Mono",
  "terminal.integrated.fontSize": 14,
  "editor.hover.enabled": "on",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.cursorStyle": "block",
  "editor.inlineSuggest.enabled": true,
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "editor.accessibilitySupport": "off",
  "editor.renderWhitespace": "all",
  "files.autoSave": "afterDelay",
  "security.workspace.trust.untrustedFiles": "open",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "git.autofetch": true,
  "cmake.configureOnOpen": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "explorer.confirmDragAndDrop": false,
  "git.openRepositoryInParentFolders": "never",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd"
    },
    "Git Bash": {
      "source": "Git Bash"
    },
    "Ubuntu (WSL)": {
      "path": "C:\\Windows\\System32\\wsl.exe",
      "args": [
        "-d",
        "Ubuntu"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "redhat.telemetry.enabled": true,
  "editor.fontFamily": "MonoLisa", // Or "'MonoLisa'"
  "editor.fontWeight": "normal",
  // When lineHeight is set to zero, VS Code will figure out the
  // the height automatically based on the font
  "editor.lineHeight": 0,
  // You can use standard CSS syntax here. To enable
  // ss01 for example, you could set "'ss01' on"
  "editor.fontSize": 14,
  "editor.fontLigatures": "'ss09' on",
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "workbench.editor.showTabs": "single",
  "[javascriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  // Vim Fix
  "vim.handleKeys": {
    "<C-w>": false,
    "<C-v>": false,
    "<C-p>": false,
    "<C-c>": false,
    "<C-f>": false,
  },
  "window.customTitleBarVisibility": "auto",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "terminal.integrated.env.osx": {
    "Q_NEW_SESSION": "1"
  },
  "github.copilot.editor.enableAutoCompletions": true,
  "dart.flutterSdkPath": "/Users/bar61aros/Developer/flutter",
  "makefile.configureOnOpen": true,
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.panel.defaultLocation": "left",
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.iconTheme": "material-icon-theme",
  "github.copilot.nextEditSuggestions.enabled": true,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "chat.mcp.gallery.enabled": true
}